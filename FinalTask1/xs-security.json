{
  "xsappname": "finaltask-auth",
  "tenant-mode": "dedicated",
  "oauth2-configuration": {
    "redirect-uris": [
      "http://localhost:5000/**",
      "https://*.cfapps.us10.hana.ondemand.com/**",
      "https://*.applicationstudio.cloud.sap/**"
    ]
  },
  "scopes": [
    {
      "name": "$XSAPPNAME.Operator",
      "description": "Operator"
    },
    {
      "name": "$XSAPPNAME.Manager",
      "description": "Manager"
    },
    {
      "name": "$XSAPPNAME.Admin",
      "description": "Admin"
    }
  ],
  "role-templates": [
    {
      "name": "Operator",
      "description": "generated",
      "scope-references": [
        "$XSAPPNAME.Operator"
      ],
      "attribute-references": []
    },
    {
      "name": "Manager",
      "description": "generated",
      "scope-references": [
        "$XSAPPNAME.Manager"
      ],
      "attribute-references": []
    },
    {
      "name": "Admin",
      "description": "generated",
      "scope-references": [
        "$XSAPPNAME.Admin"
      ],
      "attribute-references": []
    }
  ],
  "attributes": []
}
